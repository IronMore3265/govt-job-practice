# Copy to .env.local and fill in. Never commit .env.local.
# Supabase project "Govt Jobs Website" (ref kjeolamvvggqobhlcwhn): Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Vercel sends it to the daily keep-alive cron.
CRON_SECRET=
# The first sign-in with this email becomes the admin.
ADMIN_EMAIL=
